{
  "expo": {
    "name": "Neurolia",
    "slug": "Neurolia",
    "scheme": "neuroliaclean",
    "version": "1.0.0",

    "orientation": "portrait",

    "icon": "./assets/icon.jpg",

    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#18162F"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "notification": {
  "icon": "./assets/avatars/model8.png",
  "color": "#7C5CFC"
},
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#7C5CFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.deathstalker_owen.neuroliaclean"
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

 "plugins": [
  [
    "expo-build-properties",
    {
      "android": {
        "ndkVersion": "27.3.13750724"
      }
    }
  ],
  "expo-router",
  "expo-asset",
  "expo-font",
  "expo-web-browser"
],

    "extra": {
      "router": {},
      "eas": {
        "projectId": "22e8fb19-c86f-4aa9-866e-4f717d7055d0"
      }
    }
  }
}