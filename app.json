{
  "expo": {
    "name": "NeuroLia",
    "slug": "neurolia",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "neurolia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neurolia.app"
    },
    "android": {
      "package": "com.neurolia.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
            
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f49e4caa-9b08-47d9-bedb-0bcaddd780e5"
      }
    }
  }
  
}