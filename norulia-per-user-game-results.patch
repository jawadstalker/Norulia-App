+    alignItems: 'center',
+  },
+  username: { fontSize: 16, fontWeight: '700' },
+  count: { fontSize: 12 },
+  recordRow: {
+    borderTopWidth: 1,
+    paddingVertical: Spacing.sm,
+    marginTop: Spacing.sm,
+  },
+  recordGame: { fontSize: 14, fontWeight: '600' },
+  recordLine: { fontSize: 12, marginTop: 2 },
